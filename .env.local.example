# ---------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored, so your keys never leave your machine.
#
# On Vercel, add every one of these under
# Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------


# --- AI -----------------------------------------------------------------
# Your DeepSeek API key from https://platform.deepseek.com/api_keys
# This key funds every user's generations, which is why the free tier is
# capped in lib/plan.ts.
DEEPSEEK_API_KEY=

# Optional: which DeepSeek model to use. Defaults to deepseek-chat.
# DEEPSEEK_MODEL=deepseek-chat


# --- Supabase (accounts + database) --------------------------------------
# Dashboard -> Project Settings -> API
#
# The URL and anon key are sent to the browser, which is expected and safe:
# Row Level Security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - bypasses Row Level Security. SERVER ONLY.
# Never prefix this with NEXT_PUBLIC_ and never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=


# --- Polar (card payments) ------------------------------------------------
# Polar is the merchant of record, so it handles sales tax and VAT for you.
# Leave blank to run without card payments.
#
# Dashboard -> Settings -> Developers -> New Token
POLAR_ACCESS_TOKEN=

# The product customers subscribe to. Products -> your product -> copy the ID.
POLAR_PRODUCT_ID=

# Webhook signing secret. Settings -> Webhooks -> your endpoint.
POLAR_WEBHOOK_SECRET=

# "sandbox" (default) or "production". Must match which Polar account the
# token above came from - sandbox and production are entirely separate.
POLAR_SERVER=sandbox


# --- Cryptomus (crypto payments) ------------------------------------------
# Leave blank to run without crypto payments.
#
# Dashboard -> your merchant -> API keys. Use the PAYMENT key, not the payout
# key: the payment key is what signs invoices and verifies callbacks.
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_KEY=
